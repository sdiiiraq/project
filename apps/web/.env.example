# Base URL of the deployed API (NestJS on Vercel, as a separate Vercel project
# with Root Directory=apps/api). Used by next.config.mjs rewrites to proxy
# /api/* to the backend and avoid CORS in the browser.
# Local dev: http://localhost:4000
# Production: https://<your-api-project>.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:4000
