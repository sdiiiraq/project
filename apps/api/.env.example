# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database — على Vercel استخدم رابط "Connection pooling" (pgbouncer) من مزوّدك
# (Supabase / Neon / RDS Proxy...) لأن كل استدعاء لاخادومي قد يفتح اتصالاً جديدًا.
DATABASE_URL=postgresql://saas:saas_dev_password@localhost:5432/generator_saas?schema=public

# Redis — يُستخدم فقط لعدّادات معدل الطلبات (Throttler)، مع بديل في الذاكرة
# عند تعذر الاتصال (fail-soft). في الإنتاج على Vercel استخدم Upstash Redis
# (اتصال TCP يعمل من بيئة لاخادومية بلا مشاكل).
REDIS_URL=redis://localhost:6379

# Auth — generate strong random secrets for production, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-min-16-chars
JWT_REFRESH_SECRET=change-me-min-16-chars-different-from-access
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Web app URL (used in links sent via notifications, CORS, etc.)
# ضع هنا نطاق نشر apps/web على Vercel، مثال: https://your-app.vercel.app
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# File storage
# local: للتطوير المحلي فقط — لا يعمل على Vercel (نظام ملفات مؤقت غير مشترك بين الاستدعاءات)
# vercel-blob: المحرك المطلوب في الإنتاج على Vercel — أنشئ Blob Store من لوحة Vercel
# وسيوفر BLOB_READ_WRITE_TOKEN تلقائيًا كمتغيّر بيئة عند ربطه بالمشروع.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
BLOB_READ_WRITE_TOKEN=

# Rate limiting
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_GLOBAL_MAX=300

# Optional: expose Swagger docs (/api/docs) in production
ENABLE_API_DOCS=false

# Optional: error tracking (Sentry). If unset, structured logs are used instead.
SENTRY_DSN=

# مطلوب في الإنتاج على Vercel: يُقارَن مع ترويسة Authorization التي يرسلها
# Vercel Cron Jobs تلقائيًا (Bearer $CRON_SECRET) عند استدعاء مهمة الفوترة
# اليومية. عرّف نفس القيمة كمتغيّر بيئة CRON_SECRET في إعدادات مشروع Vercel.
CRON_SECRET=
