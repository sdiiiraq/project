# Supabase — من إعدادات المشروع في supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres — من Supabase (Connection Pooling للتطبيق، Direct للـ migrations)
DATABASE_URL=
DIRECT_URL=

# المساعد الذكي — مفتاح Anthropic API (احصل عليه من console.anthropic.com)
# اتركه فارغًا لتعطيل المساعد الذكي؛ بقية النظام يعمل بشكل كامل بدونه.
ANTHROPIC_API_KEY=

# يُستخدم لحماية استدعاء Vercel Cron endpoints من الوصول العشوائي
CRON_SECRET=

# رابط التطبيق العام (يُستخدم في OAuth redirect و روابط البريد)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── قاعدة بيانات الاختبار ──────────────────────────────────
# مطلوبة لتشغيل اختبارات التكامل والتزامن (pnpm test:integration).
# يجب أن تكون قاعدة بيانات منفصلة تمامًا عن الإنتاج، وباتصال مباشر
# (لا PgBouncer / لا منفذ 6543) — الاختبارات ترفض العمل خلاف ذلك.
DATABASE_URL_TEST=

# ── المساعد الذكي: ضبط اختياري ─────────────────────────────
# مهلة استدعاء Anthropic بالمللي ثانية (افتراضي 20000).
AI_TIMEOUT_MS=

# حد شهري افتراضي لطلبات AI للمولدات التي لا تملك اشتراك منصّة بعد.
# اتركه فارغًا = بلا حد (السلوك الحالي). الخطط المُعرَّفة تستخدم PlatformPlan.aiRequestLimit.
AI_DEFAULT_MONTHLY_LIMIT=
