{
  "name": "iraq-generator-saas",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "postinstall": "pnpm --filter @app/prisma generate",
    "db:migrate": "pnpm --filter @app/prisma migrate",
    "db:deploy": "pnpm --filter @app/prisma migrate:deploy",
    "db:seed": "pnpm --filter @app/prisma seed",
    "db:studio": "pnpm --filter @app/prisma studio"
  },
  "devDependencies": {
    "@prisma/client": "^6.2.1",
    "prettier": "^3.4.2",
    "prisma": "^6.2.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
