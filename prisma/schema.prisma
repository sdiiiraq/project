// AMPERE — Prisma schema
// قاعدة بيانات متعددة المستأجرين (Multi-tenant). كل جدول مرتبط ببيانات مستأجر
// (workspaceId) يجب أن يُفلتر دائمًا عبر lib/db المساعدة، وليس مباشرة.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Identity / Tenancy / RBAC
// ============================================================

// يطابق auth.users.id في Supabase — لا نخزّن كلمات المرور هنا إطلاقًا.
model User {
  id        String   @id @db.Uuid
  fullName  String
  email     String?  @unique
  phone     String?  @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedWorkspaces      Workspace[]         @relation("WorkspaceOwner")
  memberships          WorkspaceMember[]
  collectorAssignments CollectorAssignment[] @relation("CollectorAssignmentCollector")
  auditLogs            AuditLog[]
  notifications        Notification[]
  supportTickets       SupportTicket[]
  supportMessages      SupportMessage[]
  impersonationsAsAdmin AdminImpersonation[] @relation("ImpersonationAdmin")
  platformAdmin         PlatformAdmin?

  @@map("users")
}

// هوية منفصلة تمامًا عن Workspace — تُمنح يدويًا فقط (عبر seed/DB)، لا عبر أي تسجيل ذاتي.
model PlatformAdmin {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("SUPER_ADMIN")
  createdAt DateTime @default(now())

  @@map("platform_admins")
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model Workspace {
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String          @db.Uuid
  owner     User            @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  status    WorkspaceStatus @default(ACTIVE)
  region    String?
  address   String?
  normalAmperePriceIQD Decimal? @db.Decimal(14, 2)
  goldAmperePriceIQD   Decimal? @db.Decimal(14, 2)
  onboardedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  members              WorkspaceMember[]
  generators           Generator[]
  amperePlans          AmperePlan[]
  customers            Customer[]
  invoices             Invoice[]
  payments             Payment[]
  financialPeriods     FinancialPeriod[]
  ledgerEntries        LedgerEntry[]
  collectorAssignments CollectorAssignment[]
  collectorSettlements CollectorSettlement[]
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]
  fuelPurchases        FuelPurchase[]
  fuelUsages           FuelUsage[]
  equipment            Equipment[]
  maintenanceRecords   MaintenanceRecord[]
  operatingSessions    OperatingSession[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  featureOverrides     WorkspaceFeatureOverride[]
  usageRecords         Usage[]
  platformSubscription PlatformSubscription?
  supportTickets       SupportTicket[]
  impersonations       AdminImpersonation[]
  aiConversations      AIConversation[]

  @@map("workspaces")
}

// OWNER يملك كل الصلاحيات دائمًا. EMPLOYEE صلاحياته محددة فرديًا عبر WorkspaceMemberPermission —
// لا توجد أدوار وسيطة ثابتة (لا "جابي" ولا غيره)؛ المالك يمنح كل موظف صلاحياته بنفسه.
enum MemberRole {
  OWNER
  EMPLOYEE
}

model WorkspaceMember {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        MemberRole
  createdAt   DateTime   @default(now())

  permissions WorkspaceMemberPermission[]

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// صلاحية دقيقة واحدة (مثال: customers.create)
model Permission {
  key          String                      @id
  description  String
  memberGrants WorkspaceMemberPermission[]

  @@map("permissions")
}

// منح صلاحية محددة لموظف محدد — يحل محل الأدوار الثابتة القديمة (Role -> Permissions).
model WorkspaceMemberPermission {
  id            String          @id @default(uuid()) @db.Uuid
  memberId      String          @db.Uuid
  member        WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  permissionKey String
  permission    Permission      @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  createdAt     DateTime        @default(now())

  @@unique([memberId, permissionKey])
  @@index([memberId])
  @@map("workspace_member_permissions")
}

// ============================================================
// Generator / Customers
// ============================================================

model Generator {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @db.Uuid
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  ownerName    String?
  phone        String?
  region       String?
  address      String?
  capacityAmps Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customers         Customer[]
  equipment         Equipment[]
  operatingSessions OperatingSession[]

  @@index([workspaceId])
  @@map("generators")
}

// أسعار الأمبيرات (Database-driven, لكل Workspace)
model AmperePlan {
  id           String           @id @default(uuid()) @db.Uuid
  workspaceId  String           @db.Uuid
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  amperes      Int
  tier         SubscriptionTier @default(NORMAL)
  monthlyPrice Decimal          @db.Decimal(14, 2)
  isCustom     Boolean          @default(false)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())

  subscriptions CustomerSubscription[]

  @@unique([workspaceId, amperes, isCustom, tier])
  @@index([workspaceId])
  @@map("ampere_plans")
}

enum CustomerStatus {
  ACTIVE
  OVERDUE
  SUSPENDED
  DISCONNECTED
}

enum CustomerType {
  RESIDENTIAL // سكني
  COMMERCIAL  // تجاري
  NORMAL      // عادي
}

enum SubscriptionTier {
  NORMAL // عادي
  GOLD   // ذهبي
}

model Customer {
  id               String         @id @default(uuid()) @db.Uuid
  workspaceId      String         @db.Uuid
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generatorId      String         @db.Uuid
  generator        Generator      @relation(fields: [generatorId], references: [id])
  subscriberNumber String
  name             String
  phone            String?
  region           String?
  neighborhood     String?
  alley            String?
  houseNumber      String?
  notes            String?
  customerType     CustomerType   @default(NORMAL)
  status           CustomerStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  subscriptions  CustomerSubscription[]
  ampereHistory  CustomerAmpereHistory[]
  invoices       Invoice[]
  payments       Payment[]
  collectorAssignments CollectorAssignment[]

  @@unique([workspaceId, subscriberNumber])
  @@index([workspaceId, status])
  @@index([workspaceId, name])
  @@map("customers")
}

model CustomerAmpereHistory {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @db.Uuid
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  oldAmperes    Int?
  newAmperes    Int
  effectiveDate DateTime
  oldPrice      Decimal? @db.Decimal(14, 2)
  newPrice      Decimal  @db.Decimal(14, 2)
  reason        String?
  changedByUserId String @db.Uuid
  createdAt     DateTime @default(now())

  @@index([customerId])
  @@map("customer_ampere_history")
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  OVERDUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

model CustomerSubscription {
  id           String             @id @default(uuid()) @db.Uuid
  customerId   String             @db.Uuid
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amperePlanId String             @db.Uuid
  amperePlan   AmperePlan         @relation(fields: [amperePlanId], references: [id])
  amperes      Int
  tier         SubscriptionTier   @default(NORMAL)
  price        Decimal            @db.Decimal(14, 2)
  startDate    DateTime
  endDate      DateTime?
  status       SubscriptionStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  invoices Invoice[]

  @@index([customerId, status])
  @@map("customer_subscriptions")
}

// ============================================================
// Financial: Invoices / Payments / Ledger
// ============================================================

enum InvoiceStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
  OVERDUE
}

model Invoice {
  id             String                @id @default(uuid()) @db.Uuid
  workspaceId    String                @db.Uuid
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId     String                @db.Uuid
  customer       Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionId String                @db.Uuid
  subscription   CustomerSubscription  @relation(fields: [subscriptionId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  amount         Decimal               @db.Decimal(14, 2)
  paidAmount     Decimal               @default(0) @db.Decimal(14, 2)
  status         InvoiceStatus         @default(UNPAID)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  payments Payment[]

  // يمنع إنشاء فاتورة مكررة لنفس المشترك ونفس فترة الفوترة (Idempotency)
  @@unique([customerId, periodStart, periodEnd])
  @@index([workspaceId, status])
  @@map("invoices")
}

model Payment {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @db.Uuid
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId      String   @db.Uuid
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId       String?  @db.Uuid
  invoice         Invoice? @relation(fields: [invoiceId], references: [id])
  amount          Decimal  @db.Decimal(14, 2)
  date            DateTime @default(now())
  collectorUserId String?  @db.Uuid
  method          String   @default("CASH")
  note            String?
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())

  adjustments PaymentAdjustment[]
  ledgerEntry LedgerEntry?

  @@index([workspaceId, date])
  @@index([customerId])
  @@map("payments")
}

// لا يُحذف Payment مطلقًا — أي تصحيح يتم عبر Adjustment
model PaymentAdjustment {
  id            String   @id @default(uuid()) @db.Uuid
  paymentId     String   @db.Uuid
  payment       Payment  @relation(fields: [paymentId], references: [id])
  amount        Decimal  @db.Decimal(14, 2)
  reason        String
  actorUserId   String   @db.Uuid
  createdAt     DateTime @default(now())

  @@map("payment_adjustments")
}

model FinancialPeriod {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @db.Uuid
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  year         Int
  month        Int
  status       String    @default("OPEN") // OPEN | CLOSED
  closedByUserId String? @db.Uuid
  closedAt     DateTime?
  createdAt    DateTime  @default(now())

  @@unique([workspaceId, year, month])
  @@map("financial_periods")
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

// سجل مالي غير قابل للتعديل — كل حركة مالية تُسجَّل هنا
model LedgerEntry {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @db.Uuid
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type        String          // PAYMENT | ADJUSTMENT | EXPENSE | FUEL | ...
  direction   LedgerDirection
  referenceId String
  paymentId   String?         @unique @db.Uuid
  payment     Payment?        @relation(fields: [paymentId], references: [id])
  amount      Decimal         @db.Decimal(14, 2)
  description String?
  createdAt   DateTime        @default(now())

  @@index([workspaceId, type])
  @@map("ledger_entries")
}

// ============================================================
// Collectors
// ============================================================

model CollectorAssignment {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @db.Uuid
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  collectorUserId String    @db.Uuid
  collector       User      @relation("CollectorAssignmentCollector", fields: [collectorUserId], references: [id])
  customerId      String    @db.Uuid
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedAt      DateTime  @default(now())
  unassignedAt    DateTime?

  @@index([workspaceId, collectorUserId])
  @@map("collector_assignments")
}

enum SettlementStatus {
  PENDING
  COMPLETED
  DISPUTED
}

model CollectorSettlement {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @db.Uuid
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  collectorUserId String           @db.Uuid
  periodStart     DateTime
  periodEnd       DateTime
  expectedAmount  Decimal          @db.Decimal(14, 2)
  actualAmount    Decimal          @db.Decimal(14, 2)
  difference      Decimal          @db.Decimal(14, 2)
  status          SettlementStatus @default(PENDING)
  settledByUserId String?          @db.Uuid
  settledAt       DateTime?
  notes           String?
  createdAt       DateTime         @default(now())

  @@index([workspaceId, collectorUserId])
  @@map("collector_settlements")
}

// ============================================================
// Expenses / Fuel / Maintenance / Operations
// ============================================================

model ExpenseCategory {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String?   @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  isSystem    Boolean   @default(false)

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id              String          @id @default(uuid()) @db.Uuid
  workspaceId     String          @db.Uuid
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categoryId      String          @db.Uuid
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount          Decimal         @db.Decimal(14, 2)
  date            DateTime
  vendor          String?
  note            String?
  attachmentUrl   String?
  createdByUserId String          @db.Uuid
  createdAt       DateTime        @default(now())

  @@index([workspaceId, date])
  @@map("expenses")
}

model FuelPurchase {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @db.Uuid
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quantityLiters  Decimal  @db.Decimal(10, 2)
  pricePerLiter   Decimal  @db.Decimal(10, 2)
  totalCost       Decimal  @db.Decimal(14, 2)
  supplier        String?
  date            DateTime
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())

  @@index([workspaceId, date])
  @@map("fuel_purchases")
}

model FuelUsage {
  id                 String   @id @default(uuid()) @db.Uuid
  workspaceId        String   @db.Uuid
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  operatingSessionId String?  @db.Uuid
  quantityLiters     Decimal  @db.Decimal(10, 2)
  date               DateTime
  note               String?
  createdAt          DateTime @default(now())

  @@index([workspaceId, date])
  @@map("fuel_usages")
}

model Equipment {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @db.Uuid
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generatorId  String    @db.Uuid
  generator    Generator @relation(fields: [generatorId], references: [id], onDelete: Cascade)
  name         String
  model        String?
  serialNumber String?
  installedAt  DateTime?
  createdAt    DateTime  @default(now())

  maintenanceRecords MaintenanceRecord[]

  @@index([workspaceId])
  @@map("equipment")
}

model MaintenanceRecord {
  id                  String    @id @default(uuid()) @db.Uuid
  workspaceId         String    @db.Uuid
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  equipmentId         String    @db.Uuid
  equipment           Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  type                String
  date                DateTime
  cost                Decimal   @db.Decimal(14, 2)
  parts               String?
  technician          String?
  notes               String?
  nextMaintenanceDate DateTime?
  createdAt           DateTime  @default(now())

  @@index([workspaceId, date])
  @@map("maintenance_records")
}

model OperatingSession {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @db.Uuid
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generatorId     String    @db.Uuid
  generator       Generator @relation(fields: [generatorId], references: [id], onDelete: Cascade)
  startTime       DateTime
  endTime         DateTime?
  operatingHours  Decimal?  @db.Decimal(8, 2)
  downtimeMinutes Int       @default(0)
  downtimeReason  String?
  createdAt       DateTime  @default(now())

  @@index([workspaceId, startTime])
  @@map("operating_sessions")
}

// ============================================================
// Notifications / Audit
// ============================================================

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?   @db.Uuid
  user        User?     @relation(fields: [userId], references: [id])
  type        String
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String?   @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  actorUserId String?   @db.Uuid
  actor       User?     @relation(fields: [actorUserId], references: [id])
  action      String
  entity      String
  entityId    String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ============================================================
// Platform: Features / Plans / Usage / Billing (Phase 5)
// ============================================================

model Feature {
  key         String        @id
  name        String
  description String?
  planFeatures PlanFeature[]
  overrides    WorkspaceFeatureOverride[]

  @@map("features")
}

model PlatformPlan {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  slug            String   @unique
  price           Decimal  @db.Decimal(14, 2)
  currency        String   @default("IQD")
  billingCycle    String   @default("MONTHLY")
  customerLimit   Int?
  userLimit       Int?
  collectorLimit  Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  features      PlanFeature[]
  subscriptions PlatformSubscription[]

  @@map("platform_plans")
}

model PlanFeature {
  planId     String       @db.Uuid
  plan       PlatformPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureKey String
  feature    Feature      @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  enabled    Boolean      @default(true)

  @@id([planId, featureKey])
  @@map("plan_features")
}

model WorkspaceFeatureOverride {
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  featureKey  String
  feature     Feature   @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  enabled     Boolean
  reason      String?
  createdAt   DateTime  @default(now())

  @@id([workspaceId, featureKey])
  @@map("workspace_feature_overrides")
}

model Usage {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metric      String   // customers | users | collectors | storage_mb | ai_requests | reports
  value       Int
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())

  @@unique([workspaceId, metric, periodStart, periodEnd])
  @@map("usage_records")
}

enum PlatformSubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

model PlatformSubscription {
  id           String                      @id @default(uuid()) @db.Uuid
  workspaceId  String                      @unique @db.Uuid
  workspace    Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId       String                      @db.Uuid
  plan         PlatformPlan                @relation(fields: [planId], references: [id])
  status       PlatformSubscriptionStatus  @default(TRIAL)
  trialStart   DateTime?
  trialEnd     DateTime?
  startDate    DateTime                    @default(now())
  endDate      DateTime?
  price        Decimal                     @db.Decimal(14, 2)
  currency     String                      @default("IQD")
  autoRenew    Boolean                     @default(true)
  notes        String?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  transactions BillingTransaction[]

  @@map("platform_subscriptions")
}

model BillingTransaction {
  id                      String                @id @default(uuid()) @db.Uuid
  platformSubscriptionId  String                @db.Uuid
  platformSubscription    PlatformSubscription  @relation(fields: [platformSubscriptionId], references: [id], onDelete: Cascade)
  amount                  Decimal               @db.Decimal(14, 2)
  currency                String                @default("IQD")
  type                    String                // CHARGE | CREDIT | REFUND | MANUAL_ADJUSTMENT
  provider                String                @default("MANUAL")
  note                    String?
  createdAt               DateTime              @default(now())

  @@map("billing_transactions")
}

// ============================================================
// Support (Phase 6)
// ============================================================

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @db.Uuid
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUserId String          @db.Uuid
  createdBy   User                @relation(fields: [createdByUserId], references: [id])
  category    String
  subject     String
  description String
  status      SupportTicketStatus @default(OPEN)
  priority    String              @default("NORMAL")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  messages    SupportMessage[]

  @@index([workspaceId, status])
  @@map("support_tickets")
}

model SupportMessage {
  id              String         @id @default(uuid()) @db.Uuid
  ticketId        String         @db.Uuid
  ticket          SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUserId    String         @db.Uuid
  author          User           @relation(fields: [authorUserId], references: [id])
  body            String
  isInternalNote  Boolean        @default(false)
  createdAt       DateTime       @default(now())

  attachments SupportAttachment[]

  @@map("support_messages")
}

model SupportAttachment {
  id        String         @id @default(uuid()) @db.Uuid
  messageId String         @db.Uuid
  message   SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileName  String
  fileSize  Int
  mimeType  String
  createdAt DateTime       @default(now())

  @@map("support_attachments")
}

// ============================================================
// AI Assistant (Phase 7) — Workspace-scoped, بيانات مُحوسبة فقط، بدون وصول مباشر لقاعدة البيانات
// ============================================================

enum AIMessageRole {
  USER
  ASSISTANT
}

model AIConversation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  title       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  messages AIMessage[]

  @@index([workspaceId, userId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AIMessageRole
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@map("ai_messages")
}

model AdminImpersonation {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @db.Uuid
  admin       User      @relation("ImpersonationAdmin", fields: [adminUserId], references: [id])
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  reason      String?

  @@index([workspaceId])
  @@map("admin_impersonations")
}
